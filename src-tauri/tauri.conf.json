{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garam",
  "version": "0.2.1",
  "identifier": "io.jihun.garam",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Garam",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 27.5
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://avatars.githubusercontent.com; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Garam contributors",
    "copyright": "Copyright (c) 2026 Garam contributors",
    "homepage": "https://github.com/jihun-io/garam",
    "category": "DeveloperTool",
    "shortDescription": "A friendly cross-platform Git client",
    "license": "MIT",
    "linux": {
      "deb": {
        "depends": ["git"]
      }
    },
    "windows": {
      "nsis": {
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MzY5Njg2NDUwMzQ3REIKUldUYlJ3TkZocFkyUnp2b3FQWE9HeFpRK0ZLSkNhVUFKOVc1ZW5oakNscDJCNHEwclZJV2JDVGwK",
      "endpoints": ["https://github.com/jihun-io/garam/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
