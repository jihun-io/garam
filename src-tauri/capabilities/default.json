{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every repository window, the settings window and the About window",
  "windows": ["main", "repo-*", "settings", "about"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
