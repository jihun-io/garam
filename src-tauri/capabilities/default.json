{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every repository window and the settings window",
  "windows": ["main", "repo-*", "settings"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-set-title"
  ]
}
