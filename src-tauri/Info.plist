<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the app bundle's Info.plist, and embedded in dev builds.
	     Declaring the UI languages lets macOS show its own menu items
	     (Writing Tools, Emoji & Symbols, ...) in the app's language. -->
	<key>CFBundleIdentifier</key>
	<string>io.jihun.garam</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>
</dict>
</plist>
